{
  // Cloudflare Workers deploys the static build; `assets.directory` is what
  // `wrangler deploy` / `wrangler versions upload` upload.
  "name": "personal-site",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist",
    // Serve the Astro-built 404.html instead of a bare Cloudflare 404.
    "not_found_handling": "404-page",
  },
}
