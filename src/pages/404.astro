---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Jonas Balandraux">
  <section class="mx-auto max-w-3xl px-6 py-24">
    <p class="text-faint font-mono text-sm">404</p>
    <h1 class="text-ink mt-2 text-3xl font-bold tracking-tight">Page not found</h1>
    <p class="text-muted mt-4">This page doesn’t exist (or moved).</p>
    <a href="/" class="text-accent mt-8 inline-block hover:underline">← Back home</a>
  </section>
</BaseLayout>
