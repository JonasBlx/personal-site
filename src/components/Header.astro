---
import { NAV, SITE } from '../consts';
---

<header
  class="border-border bg-bg/80 supports-[backdrop-filter]:bg-bg/60 sticky top-0 z-50 border-b backdrop-blur"
>
  <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
    <a href="/" class="text-ink hover:text-accent font-semibold tracking-tight">{SITE.name}</a>
    <nav aria-label="Main navigation">
      <ul class="text-muted flex gap-6 font-mono text-sm">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="hover:text-accent transition-colors">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
