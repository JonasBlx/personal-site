---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'experiences'>;
}

const { entry } = Astro.props;
const { company, role, location, dateLabel, duration, summary, tech, highlights, url, current } =
  entry.data;
---

<article class="border-border bg-surface rounded-2xl border p-6">
  <header class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
    <h3 class="text-ink text-lg font-semibold">
      {role} ·
      {
        url ? (
          <a href={url} class="text-accent hover:underline" rel="noopener">
            {company}
          </a>
        ) : (
          company
        )
      }
      {
        current && (
          <span class="bg-accent-soft text-accent ml-2 rounded-md px-2 py-0.5 font-mono text-xs">
            current
          </span>
        )
      }
    </h3>
    <p class="text-faint font-mono text-xs">
      {dateLabel}{duration && ` · ${duration}`}
    </p>
  </header>

  <p class="text-faint mt-1 font-mono text-xs">{location}</p>

  {summary && <p class="text-muted mt-4">{summary}</p>}

  {
    highlights.length > 0 && (
      <ul class="text-muted marker:text-faint mt-4 list-disc space-y-2 pl-5">
        {highlights.map((highlight) => (
          <li>{highlight}</li>
        ))}
      </ul>
    )
  }

  {
    tech.length > 0 && (
      <ul class="mt-5 flex flex-wrap gap-2">
        {tech.map((item) => (
          <li class="bg-surface-2 text-muted rounded-md px-2 py-1 font-mono text-xs">{item}</li>
        ))}
      </ul>
    )
  }
</article>
